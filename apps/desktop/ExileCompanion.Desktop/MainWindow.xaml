<Window x:Class="ExileCompanion.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ExileCompanion.Desktop.Views"
        Title="Exile Companion"
        Width="900"
        Height="650"
        MinWidth="600"
        MinHeight="450">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Side Bar -->
        <StackPanel Grid.Column="0" Background="#202A39">
            <TextBlock Text="Exile Companion" 
                       Foreground="#F2D39C"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="16,24"/>
            <TextBlock Text="Select Game"
                       Foreground="#F2D39C"
                       Margin="16,8,16,4"/>

            <ComboBox ItemsSource="{Binding AvailableGames}"
                      SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                      Margin="12,4,12,16"
                      Height="32"/>
            <TextBlock Text="{Binding GameLoadingError}"
                        Foreground="OrangeRed"
                        TextWrapping="Wrap"
                        Margin="12,0,12,8"/>
            <Button Content="Dashboard"
                    Command="{Binding NavigateToDashboardCommand}"
                    Height="44"
                    Margin="12,8"/>

            <Button Content="Characters"
                    Command="{Binding NavigateToCharactersCommand}"
                    Height="44"
                    Margin="12,8"/>

        </StackPanel>

        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}"/>
    </Grid>

</Window>
